# ==============================================================================
# TLAMATQUI - VARIABLES DE ENTORNO PARA VERCEL (.env.vercel)
# ==============================================================================
# Copia y pega estas variables en el Panel de Vercel (Project Settings -> Environment Variables)
# Dominio de Producción: https://tlamatqui.calmecac.lat
# Dominio de API REST:   https://api.tlamatqui.calmecac.lat
# ==============================================================================

# 🔵 1. FRONTEND (Vite / SPA React 19)
# Al dejar VITE_API_URL en blanco (""), el frontend consume la API en el mismo dominio (/api/...)
VITE_API_URL=""
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"

# 🟢 2. BACKEND (API REST Express / Serverless)
PORT="4000"
FRONTEND_URL="https://tlamatqui.calmecac.lat"
CORS_ORIGIN="https://tlamatqui.calmecac.lat,http://localhost:3000"
SUPERADMIN_EMAIL="admin@tlamatqui.calmecac.lat"

# 🟢 3. BASE DE DATOS POSTGRESQL (Vercel Postgres / Neon / Supabase / Prisma Postgres)
# URL de conexión a la base de datos PostgreSQL (con pooling o directa)
DATABASE_URL="postgresql://usuario:password@host:5432/database?sslmode=require"

# 🟢 4. ALMACENAMIENTO S3 & ACELERACIÓN BUNNY CDN (Bunny Storage S3 API)
S3_ENDPOINT="https://ny-s3.storage.bunnycdn.com"
S3_REGION="ny"
S3_BUCKET_NAME="tlamatqui-storage"
S3_ACCESS_KEY="tlamatqui-storage"
S3_SECRET_KEY="your-storage-zone-password"
S3_FORCE_PATH_STYLE="true"

# Aceleración Perimetral Edge y Purga de Caché con Bunny CDN (Pull Zone)
BUNNY_CDN_HOSTNAME="https://tlamatqui-cdn.b-cdn.net"
BUNNY_API_KEY="your-bunny-account-api-key"
BUNNY_CDN_SECURITY_KEY="your-token-authentication-security-key"

# 🟢 5. RUTAS MODULARES DE ALMACENAMIENTO S3 (Espacio Unificado)
STORAGE_BASE_PATH=""
STORAGE_PATH_SCREENSHOTS="screenshots"
STORAGE_PATH_ALLIES="allies"
STORAGE_PATH_TEAMS="teams"
STORAGE_PATH_AVATARS="avatars"

# 🟢 6. SERVICIO DE CORREO TRANSACCIONAL (Brevo API v3 & Nodemailer SMTP - Opcional)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@tlamatqui.com"
BREVO_SENDER_NAME="Tlamatqui Diagnostics"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reportes Tlamatqui <no-respondas@calmecac.lat>"
