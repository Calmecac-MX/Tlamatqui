# ==============================================================================
# TLAMATQUI - VARIABLES DE ENTORNO PARA VERCEL (.env.vercel)
# ==============================================================================
# Copia y pega estas variables en el Panel de Vercel (Project Settings -> Environment Variables)
# Dominio de Producción: https://tlamatqui.calmecac.lat
# Dominio de API REST:   https://api.tlamatqui.calmecac.lat
# ==============================================================================

# 🔵 1. FRONTEND (Vite / SPA React 19)
# Al dejar VITE_API_URL en blanco (""), el frontend consume la API en el mismo dominio (/api/...)
VITE_API_URL=""
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"

# 🟢 2. BACKEND (API REST Express / Serverless)
PORT="4000"
FRONTEND_URL="https://tlamatqui.calmecac.lat"
CORS_ORIGIN="https://tlamatqui.calmecac.lat,http://localhost:3000"
SUPERADMIN_EMAIL="admin@tlamatqui.calmecac.lat"

# 🟢 4. SERVICIO DE CORREO TRANSACCIONAL (Brevo API v3 & Nodemailer SMTP - Opcional)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@tlamatqui.com"
BREVO_SENDER_NAME="Tlamatqui Diagnostics"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reportes Tlamatqui <no-respondas@calmecac.lat>"

