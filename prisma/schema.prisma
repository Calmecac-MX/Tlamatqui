// ==============================================================================
// TLAMATQUI - SCHEMA PRISMA (OPTIMIZADO Y SIMPLIFICADO CON RELACIONES PRUDENTES)
// ==============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. ENUMS (Roles y tipos de planes)
// ==============================================================================

enum Role {
  Superusuario
  Administrador
  Agente
  Visor
}


enum ShopifyPlan {
  basic
  grow
  advanced
  plus
  custom
}

enum TiendanubePlan {
  basic
  tiendanube
  advanced
  evolution
}

enum CostType {
  exact
  range
}

enum Currency {
  MXN
  USD
}

enum Semaphore {
  green
  yellow
  red
}

enum LogoType {
  text
  logo
}

// ==============================================================================
// 2. 👥 USUARIOS, EQUIPOS Y AUTENTICACIÓN
// ==============================================================================

/// Cuenta de usuario registrada en la plataforma Tlamatqui.
model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String
  role            Role         @default(Visor)
  avatar          String?
  sub             String?      @unique
  accessToken     String?
  idToken         String?
  tokenExpiresAt  DateTime?
  lastLoginAt     DateTime?    @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // 🔗 Relaciones prudenciales de usuario
  ownedTeams      Team[]       @relation("TeamOwner")
  teamMemberships TeamMember[]
  createdReports  Report[]     @relation("ReportCreator")
  apiKeys         ApiKey[]

  @@index([email])
}

/// Equipo o workspace de trabajo colaborativo de una agencia / cliente.
model Team {
  id               String       @id @default(uuid())
  name             String
  image            String?
  ownerName        String
  ownerEmail       String
  ownerId          String?
  owner            User?        @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members          TeamMember[]
  reports          Report[]
  inviteToken      String?      @default("")
  inviteRole       Role         @default(Visor)
  teamBrandName    String?
  teamBrandLogo    String?
  teamBrandWebsite String?
  allies           Ally[]
  createdAt        DateTime     @default(now())

  @@index([ownerEmail])
  @@index([ownerId])
}

/// Alianzas estratégicas o aliados asociados a un equipo.
model Ally {
  id        String   @id @default(uuid())
  name      String
  logo      String
  url       String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aliados")
  @@index([teamId])
}


/// Integrantes y roles dentro de un equipo o workspace.
model TeamMember {
  id      String  @id @default(uuid())
  name    String
  email   String
  role    Role    @default(Visor)
  avatar  String?
  teamId  String
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([userId])
  @@index([email])
}

// ==============================================================================
// 3. 📊 REPORTES DE DIAGNÓSTICO FINANCIERO Y FUGAS
// ==============================================================================

/// Reporte completo de auditoría y simulación de ahorros para clientes e-commerce.
model Report {
  id                     String                 @id @default(uuid())
  name                   String
  logo                   String?
  tagline                String?
  fugasCantidad          Int?
  fugasRangoMin          Float?
  fugasRangoMax          Float?
  visitasMensuales       Int
  gmv                    Float
  shopifyFee             Float?
  msi                    String?
  businessUrl            String?
  shopifyPlan            ShopifyPlan            @default(grow)
  shopifyPlanCustomFee   Float?
  shopifyPlanCustomPrice Float?
  shopifyAppsCostUSD     Float?
  shopifyAppsCostMXN     Float?
  tiendanubePlan         TiendanubePlan         @default(evolution)
  tools                  ReportTool[]
  comparisonRows         ReportComparisonRow[]
  contactEmail           String
  contactWhatsapp        String
  adminLogos             Json                   // Lista de logos: string[]
  brandCard1Title        String?
  brandCard1Desc         String?
  brandCard1Logo         String?
  brandCard1Link         String?
  brandCard2Title        String?
  brandCard2Desc         String?
  brandCard2Logo         String?
  brandCard2Link         String?
  finalSlideMainLogo     String?
  // 🌐 Metadatos del Comercio detectados por Chismógrafo
  detectedCms            String?                @default("Shopify")
  activeTheme            String?
  
  // 📸 Capturas Visuales
  screenshotDesktop      String?
  screenshotMobile       String?

  // 💳 Pasarelas y Stack Técnico Adicional
  paymentGateways        Json?                  // Lista de pasarelas detectadas: string[]
  pixels                 Json?                  // Lista de píxeles: { name: string, category?: string, web?: string }[]
  infrastructure         Json?                  // Lista de infraestructura: { name: string, category?: string, web?: string }[]
  
  // 📍 Servidor y Rendimiento
  serverLocation         Json?                  // { ip?: string, country?: string, city?: string, ll?: number[] }
  serverLatencyMs        Int?
  pageSpeed              ReportPageSpeed?

  createdAt              DateTime               @default(now())
  viewCount              Int                    @default(0)
  openCount              Int                    @default(0)
  uniqueVisitors         Int                    @default(0)
  uniqueVisitorIds       Json?                  // Lista de visitor IDs: string[]
  interactions           ReportInteraction?
  metrics                ReportMetrics?
  platformConfig         ReportPlatformConfig?
  analytics              ReportAnalytics?
  teamId                 String?
  team                   Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy              String?
  creatorId              String?
  creator                User?                  @relation("ReportCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([creatorId])
}

/// Auditoría de rendimiento Google Lighthouse y Core Web Vitals para el reporte.
model ReportPageSpeed {
  id                 String   @id @default(uuid())
  reportId           String   @unique
  report             Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  performanceScore   Int      @default(0)   // 0 - 100
  accessibilityScore Int      @default(0)
  seoScore           Int      @default(0)
  
  fcp                String?                // First Contentful Paint (ej. "1.7 s")
  lcp                String?                // Largest Contentful Paint (ej. "3.1 s")
  tbt                String?                // Total Blocking Time (ej. "180 ms")
  cls                String?                // Cumulative Layout Shift (ej. "0.03")
  speedIndex         String?
  interactive        String?
  
  isDemo             Boolean  @default(false)
}

/// Métricas financieras y de fugas pertenecientes a la subtabla ReportMetrics.
model ReportMetrics {
  id               String   @id @default(uuid())
  reportId         String   @unique
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  visitasMensuales Int      @default(0)
  gmv              Float    @default(0)
  fugasCantidad    Int?
  fugasRangoMin    Float?
  fugasRangoMax    Float?
}

/// Configuración de plataformas (Shopify / Tiendanube) pertenecientes a la subtabla ReportPlatformConfig.
model ReportPlatformConfig {
  id                     String         @id @default(uuid())
  reportId               String         @unique
  report                 Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  shopifyPlan            ShopifyPlan    @default(grow)
  shopifyFee             Float?
  msi                    String?
  shopifyPlanCustomFee   Float?
  shopifyPlanCustomPrice Float?
  shopifyAppsCostUSD     Float?
  shopifyAppsCostMXN     Float?
  tiendanubePlan         TiendanubePlan @default(evolution)
}



/// Métricas de interacción y analítica perteneciente a la subtabla ReportAnalytics.
model ReportAnalytics {
  id               String @id @default(uuid())
  reportId         String @unique
  report           Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  viewCount        Int    @default(0)
  openCount        Int    @default(0)
  uniqueVisitors   Int    @default(0)
  uniqueVisitorIds Json?  // Lista de visitor IDs: string[]
}

/// Herramienta / App de e-commerce diagnosticada como punto de fuga dentro de un reporte.
model ReportTool {
  id          String    @id @default(uuid())
  name        String
  category    String
  costType    CostType  @default(exact)
  costExact   Float     @default(0)
  costMin     Float     @default(0)
  costMax     Float     @default(0)
  currency    Currency  @default(USD)
  semaphore   Semaphore @default(green)
  url         String?
  description String?
  logo        String?
  reportId    String
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Filas de la tabla comparativa activas configuradas para un reporte.
model ReportComparisonRow {
  id         String @id @default(uuid())
  variable   String
  shopify    String
  tiendanube String
  pillText   String
  reportId   String
  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Métricas e historial de interacciones en tiempo real de un reporte.
model ReportInteraction {
  id                     String @id @default(uuid())
  reportId               String @unique
  report                 Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  slideViews             Json   // Record<string, number>
  whatsappClicks         Int    @default(0)
  toolClicks             Int    @default(0)
  calculatorInteractions Int    @default(0)
  timeSpentSeconds       Int    @default(0)
}

// ==============================================================================
// 4. 📋 PLANTILLAS Y SOCIOS
// ==============================================================================

/// Plantilla estándar utilizada para pre-poblar las tablas comparativas.
model ComparisonTemplate {
  id   String                  @id @default(uuid())
  name String
  rows ComparisonTemplateRow[]
}

/// Filas pertenecientes a una plantilla de comparación.
model ComparisonTemplateRow {
  id         String             @id @default(uuid())
  variable   String
  shopify    String
  tiendanube String
  pillText   String
  templateId String
  template   ComparisonTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// Configuración de marca de socio estratégico.
model Partner {
  id          String          @id @default("default")
  name        String          @default("Socio Principal")
  logo        String          @default("https://logo.clearbit.com/tiendanube.com")
  description String          @default("Socio Estratégico en Migraciones y Optimización")
  link        String?         @default("https://www.tiendanube.com.mx")
  members     PartnerMember[]
}

/// Integrantes asociados a la marca del socio estratégico.
model PartnerMember {
  id        String  @id @default(uuid())
  name      String
  email     String
  role      String  @default("Lector")
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// ==============================================================================
// 5. ⚙️ CONFIGURACIÓN GLOBAL, LLAVES Y SISTEMA
// ==============================================================================

/// Configuración global de marca blanca y parámetros de la plataforma.
model Config {
  id                     String    @id @default("default")
  adminLogoUrl           String
  adminLogo2Url          String?   @default("")
  adminLogo3Url          String?   @default("")
  adminTextUrl           String
  appUrl                 String
  defaultContactEmail    String
  defaultContactWhatsapp String
  customExchangeRate     Float
  userName               String
  userEmail              String
  userRole               Role      @default(Administrador)
  userAvatar             String
  metricsUpdateInterval  Int
  tagline                String?   @default("Auditoría Financiera y Simulación de Ahorros")
  brandCard1Title        String?
  brandCard1Desc         String?
  brandCard1Logo         String?
  brandCard1Link         String?
  brandCard2Title        String?
  brandCard2Desc         String?
  brandCard2Logo         String?
  brandCard2Link         String?
  finalSlideMainLogo     String?
  customDomain           String?   @default("")
  domainVerificationToken String?  @default("")
  domainVerified         Boolean   @default(false)
  domainVerifiedAt       DateTime?
}

/// Configuración de branding de logotipos y correo de contacto global.
model LogoConfig {
  id          String   @id @default("default")
  logoType    LogoType @default(text)
  logoText    String?
  logoFile    String?
  globalEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Llaves de API para integración programática con servicios externos.
model ApiKey {
  id            String    @id @default(uuid())
  name          String
  keyHash       String    @unique
  maskedKey     String
  status        String    @default("active")
  createdByName String?
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdById])
}

/// Estado global y modificadores del sistema (ej. Bloqueo Maestro de API).
model SystemSetting {
  id         String   @id @default("default")
  apiLocked  Boolean  @default(false)
  lockReason String?  @default("Mantenimiento programado de la API")
  updatedAt  DateTime @updatedAt
}
