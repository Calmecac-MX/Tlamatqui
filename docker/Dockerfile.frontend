# ==============================================================================
# TLAMATQUI FRONTEND DOCKERFILE (SPA React 19 + Vite 6 + Nginx)
# Multi-stage Build para Producción
# ==============================================================================

# ------------------------------------------------------------------------------
# Etapa 1: Construcción (Builder)
# ------------------------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /app

# Copiar manifiestos de dependencias
COPY package*.json ./
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY postcss.config.cjs ./
COPY index.html ./

# Instalar dependencias
RUN npm ci

# Copiar código fuente del frontend
COPY src ./src/
COPY version.json ./

# Argumentos de compilación para variables VITE_
ARG VITE_API_URL=/api
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN
ENV VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID

# Compilar frontend React a dist/
RUN npm run build:frontend

# ------------------------------------------------------------------------------
# Etapa 2: Servidor Web Nginx (Runner)
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Copiar configuración de Nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar sitio compilado desde la etapa builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
