# ==============================================================================
# TLAMATQUI BACKEND DOCKERFILE (API REST Express + Prisma ORM)
# Multi-stage Build para Producción
# ==============================================================================

# ------------------------------------------------------------------------------
# Etapa 1: Construcción (Builder)
# ------------------------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /app

# Instalar dependencias del sistema necesarias
RUN apk add --no-libc-dev openssl

# Copiar manifiestos de dependencias
COPY package*.json ./
COPY prisma ./prisma/

# Instalar todas las dependencias (incluyendo devDependencies para esbuild y typescript)
RUN npm ci

# Copiar código fuente del backend y configuraciones
COPY server.ts ./
COPY cli.ts ./
COPY server ./server/
COPY data ./data/
COPY tsconfig.json ./
COPY version.json ./
COPY openapi.json ./

# Generar Cliente Prisma
RUN npx prisma generate

# Compilar servidor backend a dist/server.cjs
RUN npm run build:backend

# ------------------------------------------------------------------------------
# Etapa 2: Ejecución en Producción (Runner)
# ------------------------------------------------------------------------------
FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

RUN apk add --no-cache openssl

# Copiar dependencias de producción y artefactos compilados
COPY package*.json ./
RUN npm ci --only=production

COPY prisma ./prisma/
RUN npx prisma generate

COPY data ./data/
COPY version.json ./
COPY openapi.json ./
COPY --from=builder /app/dist ./dist

EXPOSE 4000

CMD ["node", "dist/server.cjs"]
