# ==============================================================================
# TLAMATQUI - PLANTRÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Este archivo contiene todas las variables de entorno utilizadas por el sistema,
# estructuradas y categorizadas según su ámbito de ejecución (Frontend vs Backend).
#
# Para usarlo: Copia este archivo como `.env` y asigna las credenciales correspondientes.
# ==============================================================================

# ==============================================================================
# 🔵 1. VARIABLES EXCLUSIVAS DEL FRONTEND (SPA React 19 / Vite)
# ==============================================================================
# Nota: En Vite, todas las variables accesibles desde el navegador DEBEN llevar
# el prefijo `VITE_`. Se compilan e inyectan en el cliente web durante el build.

# VITE_API_URL: URL base pública del servidor API REST Backend que consumirá el cliente web.
# Ejemplo Local: http://localhost:4000 | Ejemplo Prod: https://api.tudominio.com
VITE_API_URL="http://localhost:4000"

# VITE_AUTH0_DOMAIN: Dominio de Auth0 (Tenant Domain) configurado para la autenticación de usuarios.
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"

# VITE_AUTH0_CLIENT_ID: ID de cliente (Client ID) de la aplicación SPA registrada en Auth0.
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"


# ==============================================================================
# 🟢 2. VARIABLES EXCLUSIVAS DEL BACKEND (API REST Express / Node.js)
# ==============================================================================
# Nota: Estas variables se ejecutan únicamente en el servidor Node.js y NUNCA se
# exponen públicamente al cliente o navegador.

# ------------------------------------------------------------------------------
# 2.1 Servidor, Red y CORS
# ------------------------------------------------------------------------------
# PORT: Puerto local de escucha del servidor API Express (Por defecto: 4000).
PORT="4000"

# BACKEND_URL: URL pública base donde está hospedada la API REST Backend.
# Ejemplo Local: http://localhost:4000 | Ejemplo Prod: https://api.tudominio.com
BACKEND_URL="http://localhost:4000"

# FRONTEND_URL: URL pública de la aplicación web cliente para redirecciones y respuestas.
# Ejemplo Local: http://localhost:3000 | Ejemplo Prod: https://tlamatqui.vercel.app
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# CORS_ORIGIN: Lista de orígenes o dominios autorizados (separados por coma) por el middleware de Express.
# Si se deja en blanco en desarrollo, refleja automáticamente el origen solicitante.
# Ejemplo: CORS_ORIGIN="https://tlamatqui.vercel.app,http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# API_SECRET_TOKEN: (Opcional) Token secreto enviado en la cabecera 'x-api-secret' para validar llamadas al Backend.
API_SECRET_TOKEN=""

# STRICT_AUTH: (Opcional) Establece autenticación estricta en producción ("true" | "false").
STRICT_AUTH="false"

# ------------------------------------------------------------------------------
# 2.2 Seguridad y Cifrado Criptográfico
# ------------------------------------------------------------------------------
# ENCRYPTION_KEY: Clave secreta o hash de 64 caracteres en hex (AES-256-GCM / HMAC)
# para cifrar datos sensibles en la base de datos (emails, tokens, SMTP pass).
ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 2.3 Base de Datos (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL: Cadena de conexión URI a la base de datos PostgreSQL.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Nota: Si se especifica, se activa Prisma ORM. Si está vacía, el Backend conmuta a almacenamiento JSON local.
DATABASE_URL=""

# Parámetros desglosados de conexión PostgreSQL (Usados solo si DATABASE_URL no está definida):
DB_HOST=""
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_SSL="false"

# ------------------------------------------------------------------------------
# 2.4 Integración con Vercel API (Aprovisionamiento de Dominios y SSL)
# ------------------------------------------------------------------------------
# VERCEL_AUTH_TOKEN: Token de acceso personal o de equipo en Vercel para auto-registrar dominios vía API.
VERCEL_AUTH_TOKEN=""

# VERCEL_PROJECT_ID: ID del proyecto en el panel de Vercel donde está alojado el Frontend.
VERCEL_PROJECT_ID=""

# VERCEL_TEAM_ID: (Opcional) ID de la organización o equipo en Vercel (si aplica).
VERCEL_TEAM_ID=""

# ------------------------------------------------------------------------------
# 2.5 Servicio de Envío de Correos (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ------------------------------------------------------------------------------
# 2.6 Personalización y Branding de Administración
# ------------------------------------------------------------------------------
ADMIN_LOGO_URL=""
ADMIN_TEXT_URL=""
