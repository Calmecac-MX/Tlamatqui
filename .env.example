# APP_URL: La URL publica donde esta desplegada la aplicación.
# Se utiliza para enlaces autoreferenciados y endpoints de API.
APP_URL="http://localhost:3000"

# ADMIN_LOGO_URL: Path or URL to the logo shown in the administrator panel.
# This can be configured by the user to display a custom branding logo.
ADMIN_LOGO_URL="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=150&q=80"

# ADMIN_TEXT_URL: Text shown in the header of the administrator panel if ADMIN_LOGO_URL is none or does not exist.
ADMIN_TEXT_URL="Evolución Diagnostics"

# DATABASE_URL: URL de conexión a la base de datos PostgreSQL remota.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# Si se especifica DATABASE_URL, la aplicación utilizará Prisma ORM con PostgreSQL.
# Si se deja vacío, la aplicación conmuta automáticamente al almacenamiento JSON local.
DATABASE_URL="postgres://sandboxSales:S@ndb0xS@les@localhost:5432/sandbox-reportes?sslmode=disable"

# Opcional: Parámetros desglosados de conexión PostgreSQL si DB_URL/DATABASE_URL no está definida.
DB_HOST=""
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_SSL="false"

# PUERTOS Y ARQUITECTURA DESACOPLADA
# PORT: Puerto independiente en el que se ejecuta el servidor Backend REST API (default: 4000)
PORT="4000"

# CORS_ORIGIN: Lista de orígenes permitidos separados por coma para entornos de producción.
# Si se deja vacío o no se especifica, permite reflejar dinámicamente el origen del cliente con credenciales.
# Ejemplo: CORS_ORIGIN="https://tiendanube-analyzer.vercel.app,http://localhost:3000"
CORS_ORIGIN=""

# VITE_API_URL: URL base del Backend consumido por el Frontend SPA.
# En desarrollo se deja vacío para usar el Proxy de Vite, o se especifica "http://localhost:4000".
VITE_API_URL="http://localhost:4000"

# AUTH0 CONFIGURATION (Vite / Frontend SPA)
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"
