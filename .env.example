# ==============================================================================
# TLAMATQUI - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como `.env` en la raíz del proyecto para trabajar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔵 1. FRONTEND (SPA React 19 / Vite)
# ------------------------------------------------------------------------------
# URL base de la API REST Backend consumida por la SPA
VITE_API_URL="http://localhost:4000"

# Autenticación de usuarios con Auth0
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"

# ------------------------------------------------------------------------------
# 🟢 2. BACKEND (API REST Express / Node.js)
# ------------------------------------------------------------------------------
# Puerto local del servidor y URL cliente para CORS y enlaces de reportes
PORT="4000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,https://tlamatqui.calmecac.lat"

# ------------------------------------------------------------------------------
# 🟢 3. BASE DE DATOS (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# URI de conexión a PostgreSQL. Si está vacía, opera en fallback JSON local (`data/`).
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 🟢 4. SERVICIO DE CORREO SMTP (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reportes Tlamatqui <no-respondas@calmecac.lat>"
