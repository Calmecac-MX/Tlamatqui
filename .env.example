# ==============================================================================
# TLAMATQUI - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como `.env` en la raíz del proyecto para trabajar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔵 1. FRONTEND (SPA React 19 / Vite)
# ------------------------------------------------------------------------------
# URL base de la API REST Backend. En desarrollo local o arquitectura desacoplada usa "http://localhost:4000".
# Para despliegue de dominio único (Single Domain en Vercel/Proxy), déjala en blanco ("") para usar rutas relativas /api
VITE_API_URL="http://localhost:4000"

# Autenticación de usuarios con Auth0
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"

# ------------------------------------------------------------------------------
# 🟢 2. BACKEND (API REST Express / Node.js)
# ------------------------------------------------------------------------------
# Puerto local del servidor y URL cliente para CORS y enlaces de reportes
PORT="4000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,https://tlamatqui.calmecac.lat"

# Correo del primer Superusuario del sistema (Opcional - Asigna rol Superusuario automáticamente)
SUPERADMIN_EMAIL="admin@tlamatqui.calmecac.lat"

# ------------------------------------------------------------------------------
# 🟢 3. BASE DE DATOS (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# URI de conexión a PostgreSQL. Si está vacía, opera en fallback JSON local (`data/`).
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 🟢 4. SERVICIO DE CORREO TRANSACCIONAL (Brevo API v3 & Nodemailer SMTP)
# ------------------------------------------------------------------------------
# API REST v3 de Brevo (Recomendado - Mayor entregabilidad)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@tlamatqui.com"
BREVO_SENDER_NAME="Tlamatqui Diagnostics"

# Fallback a Servidor SMTP convencional
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reportes Tlamatqui <no-respondas@calmecac.lat>"

# ------------------------------------------------------------------------------
# 🟢 5. ALMACENAMIENTO S3 & ACELERACIÓN BUNNY CDN (Bunny.net / AWS / R2 / MinIO)
# ------------------------------------------------------------------------------
# Configuración de S3 (Compatible con Bunny Storage S3, Cloudflare R2, MinIO, AWS)
S3_ENDPOINT="https://ny-s3.storage.bunnycdn.com"
S3_REGION="ny"
S3_BUCKET_NAME="tlamatqui-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"

# Aceleración Perimetral Edge y Purga de Caché con Bunny CDN (Pull Zone)
BUNNY_CDN_HOSTNAME="https://tlamatqui-cdn.b-cdn.net"
BUNNY_API_KEY=""
# Clave de seguridad para Bunny CDN Advanced Token Authentication (HMAC-SHA256 URL Signing)
BUNNY_CDN_SECURITY_KEY=""

# ------------------------------------------------------------------------------
# 🟢 6. RUTAS MODULARES DE ALMACENAMIENTO S3 & ESPACIO UNIFICADO
# ------------------------------------------------------------------------------
# Prefijo raíz opcional para agrupar todo en un mismo espacio/carpeta (ej. "tlamatqui" o vacío "")
STORAGE_BASE_PATH=""

# Ruta destino para capturas de pantalla de tiendas / diagnósticos de auditoría
STORAGE_PATH_SCREENSHOTS="screenshots"

# Ruta destino para logos de aliados, pasarelas de pago y tecnologías
STORAGE_PATH_ALLIES="allies"

# Ruta destino para logos e identidades visuales de equipos y agencias
STORAGE_PATH_TEAMS="teams"

# Ruta destino para fotos de perfil y avatares de usuarios
STORAGE_PATH_AVATARS="avatars"


