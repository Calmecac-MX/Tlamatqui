# ==============================================================================
# TLAMATQUI - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Este archivo contiene las variables de entorno necesarias para la aplicación.
# Para utilizarlo: Copia este archivo como `.env` y asigna tus credenciales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔵 1. FRONTEND (SPA React 19 / Vite - Acceso del Navegador)
# ------------------------------------------------------------------------------
# VITE_API_URL: URL base de la API REST Backend consumida por la SPA desde el navegador.
VITE_API_URL="http://localhost:4000"

# VITE_AUTH0_DOMAIN: Dominio del tenant de Auth0 para autenticación de usuarios.
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"

# VITE_AUTH0_CLIENT_ID: ID de cliente (Client ID) de la SPA en Auth0.
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"

# VITE_AUTH0_AUDIENCE: (Opcional) Audience de la API en Auth0 para tokens JWT.
VITE_AUTH0_AUDIENCE=""

# VITE_API_SECRET_TOKEN: (Opcional) Token secreto enviado en la cabecera 'x-api-secret' desde el cliente.
VITE_API_SECRET_TOKEN=""

# ------------------------------------------------------------------------------
# 🟢 2. BACKEND (API REST Express / Node.js - Exclusivo del Servidor)
# ------------------------------------------------------------------------------
# PORT: Puerto local de escucha del servidor Express (Por defecto: 4000).
PORT="4000"

# FRONTEND_URL: URL pública de la aplicación cliente Frontend para CORS y redirecciones.
FRONTEND_URL="http://localhost:3000"

# API_SECRET_TOKEN: (Opcional) Token secreto esperado en la cabecera 'x-api-secret'.
API_SECRET_TOKEN=""

# STRICT_AUTH: (Opcional) Exige autenticación estricta en producción ("true" | "false").
STRICT_AUTH="false"

# ENCRYPTION_KEY: Clave de cifrado criptográfico de 256 bits (32 bytes / 64 hex chars) en AES-256-GCM.
ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 🟢 3. BASE DE DATOS (PostgreSQL / Prisma ORM 7)
# ------------------------------------------------------------------------------
# DATABASE_URL: URI de conexión a la base de datos PostgreSQL.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Nota: Si se especifica, activa Prisma ORM. Si está vacía, opera en fallback JSON local.
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 🟢 4. SERVICIO DE CORREO SMTP (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ------------------------------------------------------------------------------
# 🟢 5. INTEGRACIÓN CON VERCEL API (Aprovisionamiento de Dominios y SSL - Opcional)
# ------------------------------------------------------------------------------
VERCEL_AUTH_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
