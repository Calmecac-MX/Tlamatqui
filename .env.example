# ==========================================
# 1. ARQUITECTURA Y DESPLIEGUE DESACOPLADO (URLS)
# ==========================================
# FRONTEND_URL: URL pública donde se ejecuta/despliega la aplicación Frontend (SPA React 19 / Vite).
# Ejemplo Local: http://localhost:3000 | Ejemplo Prod: https://tlamatqui.vercel.app
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# BACKEND_URL: URL pública base donde está alojada la API REST Backend (Express Node.js).
# Ejemplo Local: http://localhost:4000 | Ejemplo Prod: https://api.midominio.com
BACKEND_URL="http://localhost:4000"

# PORT: Puerto de escucha del servidor Backend API REST (default: 4000)
PORT="4000"

# CORS_ORIGIN: Lista de orígenes autorizados (separados por coma) permitidos por la API Backend Express.
# Si se deja vacío, permite reflejar dinámicamente el origen del cliente en desarrollo.
# Ejemplo: CORS_ORIGIN="https://tlamatqui.vercel.app,http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# VITE_API_URL: URL base del Backend que consume el cliente web Frontend SPA desde el navegador.
# En producción o cuando el frontend corre de forma independiente, debe apuntar a la URL pública de la API REST.
# Ejemplo Local: http://localhost:4000 | Ejemplo Prod: https://api.midominio.com
VITE_API_URL="http://localhost:4000"

# ==========================================
# 2. ADMINISTRACIÓN Y BRANDING
# ==========================================
# ADMIN_LOGO_URL: URL o ruta de imagen para el logotipo del panel de administración.
ADMIN_LOGO_URL=
# ADMIN_TEXT_URL: Texto descriptivo en cabecera de administración si no hay logo.
ADMIN_TEXT_URL=

# ==========================================
# 3. BASE DE DATOS (POSTGRESQL / PRISMA)
# ==========================================
# DATABASE_URL: URL de conexión a la base de datos PostgreSQL remota.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# Si se especifica DATABASE_URL, la aplicación utilizará Prisma ORM con PostgreSQL.
# Si se deja vacío, la aplicación conmuta automáticamente al almacenamiento JSON local.
DATABASE_URL=

# Opcional: Parámetros desglosados de conexión PostgreSQL si DB_URL/DATABASE_URL no está definida.
DB_HOST=""
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_SSL="false"

# ==========================================
# 4. AUTH0 CONFIGURATION (Vite / Frontend SPA)
# ==========================================
VITE_AUTH0_DOMAIN="rifatela-mx.us.auth0.com"
VITE_AUTH0_CLIENT_ID="z7UvbydlrkRpaF4M6KFjqxcdvIz5VFpa"

# ==========================================
# 5. CONFIGURACIÓN DE CORREO SMTP (NODEMAILER)
# ==========================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""


