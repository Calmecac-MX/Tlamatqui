{
  "name": "tlamatqui",
  "private": true,
  "version": "2.6.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "browser-tabs-lock": true,
    "core-js": true,
    "esbuild": true,
    "prisma": true
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,magenta.bold\" -n \"backend,frontend\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx server.ts",
    "dev:frontend": "vite --port 3000",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:frontend": "vite build",
    "vercel-build": "prisma generate && npm run build",
    "start": "node dist/server.cjs",
    "start:backend": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "docs": "npx jsdoc -c jsdoc.json",
    "cli": "tsx cli.ts",
    "auto-version": "node scripts/auto-version.js",
    "version": "npm run auto-version && git add version.json openapi.json src/version.ts server/version.ts",
    "bump:frontend": "node scripts/auto-version.js --bump-frontend",
    "bump:backend": "node scripts/auto-version.js --bump-backend",
    "bump:both": "node scripts/auto-version.js --bump-both",
    "changelog": "node scripts/generate-changelog.js"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/config": "^7.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/auth0-lock": "^11.27.9",
    "@vitejs/plugin-react": "^5.0.4",
    "auth0-lock": "^15.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
