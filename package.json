{
  "name": "tlamatqui-monorepo",
  "private": true,
  "version": "2.5.20",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,magenta.bold\" -n \"backend,frontend\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@tlamatqui/backend",
    "dev:frontend": "npm run dev --workspace=@tlamatqui/frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=@tlamatqui/frontend",
    "build:backend": "npm run build --workspace=@tlamatqui/backend",
    "vercel-build": "cd apps/backend && npx prisma generate && cd ../.. && npm run build",
    "start": "npm run start --workspace=@tlamatqui/backend",
    "start:backend": "npm run start --workspace=@tlamatqui/backend",
    "preview": "npm run preview --workspace=@tlamatqui/frontend",
    "clean": "rm -rf dist apps/frontend/dist apps/backend/dist",
    "lint": "npm run lint --workspace=@tlamatqui/frontend && npm run lint --workspace=@tlamatqui/backend",
    "docs": "npx jsdoc -c jsdoc.json",
    "cli": "npm run cli --workspace=@tlamatqui/backend",
    "auto-version": "node scripts/auto-version.js",
    "version": "npm run auto-version && git add version.json openapi.json apps/frontend/src/version.ts apps/backend/server/version.ts",
    "bump:frontend": "node scripts/auto-version.js --bump-frontend",
    "bump:backend": "node scripts/auto-version.js --bump-backend",
    "bump:both": "node scripts/auto-version.js --bump-both",
    "changelog": "node scripts/generate-changelog.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
